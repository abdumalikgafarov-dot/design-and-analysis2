public class BinarySearch {

    public static int binarySearchIterative(int[] a, int target) {
        int left = 0;
        int high = a.length - 1;

        while (left <= high) {
            int mid = left + (high - left) / 2;

            if (a[mid] == target) {
                return mid;
            } else if (target < a[mid]) {
                high = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int[] a = {-5, 0, 3, 5, 9, 12, 18, 25};

        System.out.println("Array: " + java.util.Arrays.toString(a));
        System.out.println("Index of 9: " + binarySearchIterative(a, 9));
        System.out.println("Index of 4: " + binarySearchIterative(a, 4));
    }
}
